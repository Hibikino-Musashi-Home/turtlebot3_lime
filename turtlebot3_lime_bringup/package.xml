<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>turtlebot3_lime_bringup</name>
  <version>2.1.1</version>
  <description>
    ROS 2 package for turtlebot3_lime
  </description>
  <maintainer email="willson@robotis.com">Will Son</maintainer>
  <license>Apache 2.0</license>
  <url type="website">https://emanual.robotis.com/docs/en/platform/turtlebot3/lime/</url>
  <url type="repository">https://github.com/ROBOTIS-GIT/turtlebot3_lime</url>
  <url type="bugtracker">https://github.com/ROBOTIS-GIT/turtlebot3_lime/issues</url>
  <author email="thlim@robotis.com">Darby Lim</author>
  <author email="hjkim@robotis.com">Hye-jong KIM</author>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>imu_sensor_broadcaster</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>turtlebot3_lime_description</exec_depend>
  <exec_depend>turtlebot3_lime_hardware</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
