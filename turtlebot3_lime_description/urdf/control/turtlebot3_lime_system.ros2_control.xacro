<?xml version="1.0"?>
<!--
Copied and modified from ros2 control demos example:
https://github.com/ros-controls/ros2_control_demos/blob/foxy/ros2_control_demo_description/diffbot_description/ros2_control/diffbot_system.ros2_control.xacro
https://github.com/ros-controls/ros2_control_demos/blob/foxy/ros2_control_demo_description/rrbot_description/ros2_control/rrbot_system_position_only.ros2_control.xacro
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="ros_distro" value="$(env ROS_DISTRO)" />

  <xacro:macro
    name="turtlebot3_lime_system"
    params="name prefix use_gazebo:=^|false use_fake_hardware:=^|false fake_sensor_commands:=^|false">

    <ros2_control name="${name}" type="system">

      <hardware>
        <xacro:if value="${use_fake_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="fake_sensor_commands">${fake_sensor_commands}</param>
          <param name="state_following_offset">0.0</param>
        </xacro:if>

        <xacro:unless value="${use_fake_hardware}">
          <xacro:if value="${use_gazebo}">
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
          </xacro:if>

          <xacro:unless value="${use_gazebo}">
            <plugin>turtlebot3_lime_hardware/TurtleBot3LimeSystemHardware</plugin>
            <param name="opencr_id">200</param>
            <param name="opencr_usb_port">/dev/ttyACM0</param>
            <param name="opencr_baud_rate">1000000</param>
            <param name="dxl_joints_profile_acceleration">100</param>
            <param name="dxl_joints_profile_velocity">500</param>
            <param name="dxl_gripper_profile_acceleration">20</param>
            <param name="dxl_gripper_profile_velocity">200</param>
          </xacro:unless>
        </xacro:unless>
      </hardware>

      <!--
        Define the initial command values here to keep the initial commands
        consistent across hardware, Gazebo, and fake hardware.
      -->
      <joint name="${prefix}wheel_left_joint">
        <command_interface name="velocity">
          <param name="min">-24.5</param>
          <param name="max">24.5</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="${prefix}wheel_right_joint">
        <command_interface name="velocity">
          <param name="min">-24.5</param>
          <param name="max">24.5</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

      <sensor name="imu">
        <state_interface name="orientation.x">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="orientation.y">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="orientation.z">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="orientation.w">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="angular_velocity.x">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="angular_velocity.y">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="angular_velocity.z">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="linear_acceleration.x">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="linear_acceleration.y">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="linear_acceleration.z">
          <param name="initial_value">0.0</param>
        </state_interface>
      </sensor>

      <sensor name="battery">
        <state_interface name="battery_voltage">
          <param name="initial_value">12.0</param>
        </state_interface>
        <state_interface name="battery_percentage">
          <param name="initial_value">100.0</param>
        </state_interface>
        <xacro:unless value="${ros_distro == 'humble'}">
          <state_interface name="battery_present" data_type="bool">
            <param name="initial_value">true</param>
          </state_interface>
        </xacro:unless>
      </sensor>

      <joint name="${prefix}joint1">
        <command_interface name="position">
          <param name="min">${-pi*0.9}</param>
          <param name="max">${pi*0.9}</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="${prefix}joint2">
        <command_interface name="position">
          <param name="min">${-pi*0.57}</param>
          <param name="max">${pi*0.5}</param>
          <param name="initial_value">-1.10</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">-1.10</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <!-- FIXME Verify the joint3 limits and set a valid initial position. -->
      <joint name="${prefix}joint3">
        <command_interface name="position">
          <param name="min">${-pi*0.3}</param>
          <param name="max">${pi*0.44}</param>
          <param name="initial_value">1.80</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">1.80</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="${prefix}joint4">
        <command_interface name="position">
          <param name="min">${-pi*0.57}</param>
          <param name="max">${pi*0.65}</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="${prefix}joint5">
        <command_interface name="position">
          <param name="min">${-pi*0.57}</param>
          <param name="max">${pi*0.65}</param>
          <param name="initial_value">0.98</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.98</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="${prefix}joint6">
        <command_interface name="position">
          <param name="min">${-pi*0.57}</param>
          <param name="max">${pi*0.65}</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <!-- FIXME Verify the gripper joint limits against the URDF and teleop commands. -->
      <joint name="${prefix}gripper_left_joint">
        <command_interface name="position">
          <param name="min">-0.010</param>
          <param name="max">0.019</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="${prefix}gripper_right_joint">
        <param name="mimic">${prefix}gripper_left_joint</param>
        <param name="multiplier">1</param>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

    </ros2_control>

    <xacro:if value="${use_gazebo}">
      <gazebo>
        <plugin
          filename="gz_ros2_control-system"
          name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <robot_param>robot_description</robot_param>
          <robot_param_node>robot_state_publisher</robot_param_node>
          <parameters>
            $(find turtlebot3_lime_gazebo)/config/ros2_controllers.yaml
          </parameters>
          <ros>
            <xacro:if value="${ros_distro == 'humble'}">
              <remapping>
                /diff_drive_controller/cmd_vel_unstamped:=/cmd_vel
              </remapping>
            </xacro:if>
            <xacro:unless value="${ros_distro == 'humble'}">
              <remapping>
                /diff_drive_controller/cmd_vel:=/cmd_vel
              </remapping>
            </xacro:unless>
            <remapping>
              /diff_drive_controller/odom:=/odom
            </remapping>
          </ros>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>

</robot>